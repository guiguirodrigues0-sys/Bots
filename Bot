 /**
 * Verifica se os ticks estão chegando normalmente.
 * Se não houver ticks por mais de 60 segundos, tenta re-assinar.
 */
 private async checkTickHealth(): Promise<void> {
 if (this.state !== "RUNNING" || !this.ws || !this.ws.isConnected) {
 return;
 }
 const now = Date.now();
 if (this.lastTickAt && now - this.lastTickAt > 60000) {
 this.lastError = `Sem ticks por ${Math.round((now - this.lastTickAt) / 1000)}s — tentando re-assinar`;
 this.setEvent("TICKS AUSENTES — REASSINANDO");
 logger.warn(this.lastError);
 try {
 const config = this.activeConfig();
 if (config) {
 await this.ws.request({ forget_all: "ticks" });
 await this.ws.request({ ticks: config.symbol, subscribe: 1 });
 this.setEvent("TICKS REASSINADOS");
 }
 } catch (err) {
 logger.error("Falha ao re-assinar ticks", { message: err instanceof Error ? err.message : String(err) });
 }
 }
 }
 /**
 * Verifica se os candles estão fechando normalmente.
 * Se não houver candle fechado por mais de 2x granularity, alerta.
 */
 private async checkCandleHealth(): Promise<void> {
 if (this.state !== "RUNNING") {
 return;
 }
 const config = this.activeConfig();
 if (!config || !config.granularity) {
 return;
 }
 const now = Date.now();
 const expectedInterval = config.granularity * 1000 * 2; // 2x o intervalo esperado
 if (this.lastCandleAt && now - this.lastCandleAt > expectedInterval) {
 const msg = `Candle não fecha há ${Math.round((now - this.lastCandleAt) / 1000)}s (esperado
~${config.granularity}s)`;
 this.lastError = msg;
 this.setEvent("CANDLE TRAVADO — VERIFICAR CONEXÃO");
 logger.warn(msg);
 }
 }
 /**
 * Re-consulta o estado de contratos abertos cuja duração já expirou. O
 * contador local NÃO é confirmação de liquidação — a API é a fonte da
 * verdade. Se a mensagem de liquidação (streaming) for perdida, esta
 * re-consulta garante a reconciliação.
 *
 * Implementa retry com backoff exponencial e evita consultas duplicadas
 * simultâneas para o mesmo contract_id.
 *
 * Para contratos de curta duração (< 5 min), verifica mais agressivamente.
 */
 private async checkExpiredContracts(): Promise<void> {
 const ws = this.ws;
 if (!ws || !ws.isConnected) {
 return;
 }
 const now = Date.now();
 const expired = this.openTrades.filter(
 (t) =>
 (t.status === "OPEN" || t.status === "PENDING") &&
 t.durationSeconds > 0 &&
 now - t.entryTime >= (t.durationSeconds + 5) * 1000,
 );
 for (const t of expired) {
 // Verifica se já tentou recentemente e deve aguardar (backoff exponencial)
 const attemptInfo = this.reconciliationAttempts.get(t.contractId);
 if (attemptInfo && now < attemptInfo.nextRetryAt) {
 continue; // Ainda não é hora de tentar novamente
 }
 try {
 const msg = await ws.request({
 proposal_open_contract: 1,
 contract_id: contractIdParam(t.contractId),
 });
 // Re-encaminha a resposta ao monitor, que centraliza a determinação
 // do resultado e a extração de profit/sell_price/buy_price.
 this.monitor.handleMessage(msg as WsMessage);
 // Sucesso: limpa o registro de tentativas
 this.reconciliationAttempts.delete(t.contractId);
 } catch (err) {
 // Registra a tentativa falhada com backoff exponencial
 const attemptCount = (attemptInfo?.count ?? 0) + 1;
 const baseDelayMs = 5000; // 5 segundos base
 const maxDelayMs = 300000; // 5 minutos máximo
 const delayMs = Math.min(baseDelayMs * Math.pow(2, attemptCount - 1), maxDelayMs);
 const nextRetryAt = Date.now() + delayMs;
 this.reconciliationAttempts.set(t.contractId, {
 count: attemptCount,
 lastAttempt: Date.now(),
 nextRetryAt,
 });
 // Extrai detalhes do erro da API (código, mensagem)
 const message = err instanceof Error ? err.message : String(err);
 const errorDetail = err && typeof err === "object" && "response" in err
 ? (err as any).response?.data ?? message
 : message;
 logger.warn("Falha ao re-consultar contrato expirado (tentativa será refeita)", {
 contractId: t.contractId,
 attempt: attemptCount,
 nextRetryInMs: delayMs,
 error: errorDetail,
 });
 this.lastError = `Erro de sincronização (tentativa ${attemptCount}) — não foi possível consultar a liquidação do
contrato ${t.contractId}: ${errorDetail}`;
 this.setEvent(`ERRO DE SINCRONIZAÇÃO (tentativa ${attemptCount}) — REASSINANDO...`);
 }
 }
 // Verificação adicional: contratos PENDING que ainda não expiraram mas estão há mais de 30s sem atualização
 // (possível perda de mensagem de streaming)
 const stalePending = this.openTrades.filter(
 (t) =>
 t.status === "PENDING" &&
 now - t.entryTime >= 30000, // 30 segundos sem atualização
 );
 for (const t of stalePending) {
 try {
 const msg = await ws.request({
 proposal_open_contract: 1,
 contract_id: contractIdParam(t.contractId),
 });
 this.monitor.handleMessage(msg as WsMessage);
 } catch (err) {
 logger.debug("Falha ao verificar contrato PENDING antigo", {
 contractId: t.contractId,
 error: err instanceof Error ? err.message : String(err),
 });
 }
 }
 }
 private async loadMarket(symbol: string, granularity: number): Promise<void> {
 const ws = this.ws;
 if (!ws) {
 throw new Error("WebSocket indisponível.");
 }
 const candles = await fetchCandles(ws, symbol, granularity, 500);
 this.manager.resetBuffers();
 for (const c of candles) {
 this.manager.onCandle(c);
 }
 this.aggregator = new CandleAggregator(granularity, candles.at(-1));
 this.aggregator.onCandleClose((candle) => this.onCandleClose(candle));
 try {
 await ws.request({ forget_all: "ticks" });
 } catch {
 /* ignore */
 }
 await ws.request({ ticks: symbol, subscribe: 1 });
 this.warmup = false;
 this.setEvent("DADOS DE MERCADO CARREGADOS");
 logger.info("Mercado carregado", { symbol, granularity, candles: candles.length });
 }
 private handleMessage(msg: Record<string, any>): void {
 this.monitor.handleMessage(msg);
 const config = this.activeConfig();
 if (msg.msg_type === "tick" && msg.tick?.symbol === config?.symbol) {
 const tick = msg.tick as { quote: number; epoch: number };
 const now = Date.now();
 this.lastTickAt = now;
 // Atualiza lastTickAt dos trades abertos deste símbolo
 if (config) {
 for (const t of this.openTrades) {
 if (t.status === "OPEN" || t.status === "PENDING" && t.symbol === config.symbol) {
 t.lastTickAt = now;
 }
 }
 }
 this.aggregator?.onTick(tick.epoch, tick.quote);
 } else if (msg.msg_type === "balance" && msg.balance) {
 const b = msg.balance as { balance: number; currency: string };
 this.updateBalance(b.balance, b.currency);
 }
 }
 private onCandleClose(candle: Candle): void {
 const signal = this.manager.onCandle(candle);
 if (signal) {
 this.lastSignal = signal;
 }
 this.lastCandleAt = Date.now();
 if (this.warmup || this.state !== "RUNNING" || this.switching) {
 return;
 }
 if (signal && signal.direction !== "WAIT") {
 void this.evaluateAndMaybeTrade(signal);
 }
 }
 private updateBalance(balance: number, currency: string): void {
 this.balance = balance;
 this.currency = currency;
 this.stats.currentBalance = balance;
 if (this.stats.initialBalance === 0) {
 this.stats.initialBalance = balance;
 }
 this.stats.sessionPnL = balance - this.stats.initialBalance;
 this.emit("balance", { balance, currency });
 }
 private async evaluateAndMaybeTrade(signal: StrategySignal): Promise<void> {
 this.lastEvaluationAt = Date.now();
 const config = this.activeConfig();
 if (!config || !this.ws || this.balance === null || this.currency === null) {
 return;
 }
 if (signal.direction === "WAIT") {
 return;
 }
 // Evita condição de corrida: uma única operação em andamento por vez.
 if (this.tradeInFlight) {
 this.decisionBlockReason = "Operação anterior ainda em execução.";
 return;
 }
 const activeId = this.manager.getActiveId();
 if (!activeId) {
 return;
 }
 // Limite de operações por ativação (config individual; 0 = ilimitado).
 const maxTrades = config.maxTrades;
 if (maxTrades > 0 && this.stats.trades >= maxTrades) {
 this.decisionBlockReason = `Limite de ${maxTrades} operações atingido para esta estratégia.`;
 this.manager.recordRejected({
 timestamp: Date.now(),
 strategyId: activeId,
 direction: signal.direction,
 reason: this.decisionBlockReason,
 reasonCode: "RISK_BLOCKED",
 });
 return;
 }
 // Config global com o cooldown mais restritivo (global vs individual).
 const globalRisk = this.getRiskConfig();
 const effectiveRisk: StrategyRiskConfig = {
 ...globalRisk,
 cooldownSeconds: effectiveCooldownSeconds(globalRisk, config.cooldownSeconds),
 };
 const risk = evaluateStrategyRisk(
 {
 // OPEN e PENDING contam para limite de posições - ambos representam capital comprometido
 openCount: this.activePositionCount(),
 exposurePct: this.currentExposurePct(),
 consecutiveLosses: this.stats.consecutiveLosses,
 pnlPct:
 this.stats.initialBalance > 0
 ? (this.stats.sessionPnL / this.stats.initialBalance) * 100
 : 0,
 lastEntryAt: this.lastEntryTime,
 now: Date.now(),
 },
 effectiveRisk,
 );
 if (!risk.ok) {
 this.decisionBlockReason = risk.reason;
 this.manager.recordRejected({
 timestamp: Date.now(),
 strategyId: activeId,
 direction: signal.direction,
 reason: risk.reason,
 reasonCode: riskReasonCode(risk.reason),
 });
 if (/perdas consecutivas|Stop diário/.test(risk.reason)) {
 this.setEvent(`ESTRATÉGIA PARADA — ${risk.reason.toUpperCase()}`);
 await this.stop();
 return;
 }
 return;
 }
 // Stake efetiva: individual, mas nunca acima do teto global.
 const stake = computeEffectiveStrategyStake(
 this.balance,
 config,
 globalRisk,
 this.currency,
 );
 if (stake <= 0) {
 this.decisionBlockReason = "Stake inválida após normalização.";
 return;
 }
 const validation = await validateStrategyContract(
 this.ws,
 config.symbol,
 config.contractType,
 config.duration,
 config.durationUnit,
 stake,
 );
 if (!validation.ok) {
 this.decisionBlockReason = validation.reason;
 this.manager.recordRejected({
 timestamp: Date.now(),
 strategyId: activeId,
 direction: signal.direction,
 reason: validation.reason,
 reasonCode: contractReasonCode(validation.reason),
 });
 this.setEvent(`OPERAÇÃO BLOQUEADA — ${validation.reason}`);
 return;
 }
 const direction: Direction = signal.direction === "BUY" ? "CALL" : "PUT";
 // Reserva slot antes de enviar a compra
 const tempContractId = `temp_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
 if (!this.reserveSlot(tempContractId, stake, config.symbol)) {
 this.decisionBlockReason = "Limite de risco atingido (posições simultâneas ou exposição).";
 this.setEvent("OPERAÇÃO BLOQUEADA — LIMITE DE RISCO");
 return;
 }
 await this.placeTrade(activeId, signal, direction, stake);
 }
 private async placeTrade(
 strategyId: StrategyId,
 signal: StrategySignal,
 direction: Direction,
 stake: number,
 ): Promise<void> {
 const config = this.activeConfig();
 if (!config || !this.ws || this.currency === null) {
 return;
 }
 this.tradeInFlight = true;
 
 // Reserva slot ANTES de enviar a compra (com ID temporário)
 const tempContractId = `temp_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
 if (!this.reserveSlot("temp_" + Date.now(), stake, this.activeConfig()?.symbol || "")) {
 this.decisionBlockReason = "Limite de risco atingido (posições simultâneas ou exposição).";
 this.setEvent("OPERAÇÃO BLOQUEADA — LIMITE DE RISCO");
 this.tradeInFlight = false;
 return;
 }
 
 try {
 const trade = await this.executor.execute(
 this.ws,
 config.symbol,
 direction,
 stake,
 config.duration,
 config.durationUnit,
 this.currency,
 { skipAvailabilityCheck: true },
 );
 
 // Atualiza reserva com o contractId real
 this.releaseReservation("temp_" + Date.now()); // Remove reserva temporária
 this.reserveSlot(trade.contractId, stake, config.symbol); // Reserva com ID real
 
 const entryTime = Date.now();
 const open: OpenStrategyTrade = {
 contractId: trade.contractId,
 proposalId: trade.proposalId,
 symbol: config.symbol,
 strategyId,
 direction,
 stake,
 entryTime,
 duration: config.duration,
 durationSeconds: durationInSeconds(config.duration, config.durationUnit),
 durationUnit: config.durationUnit,
 granularity: config.granularity,
 askPrice: trade.askPrice,
 buyPrice: trade.buyPrice,
 payout: trade.payout,
 status: "PENDING",
 profit: null,
