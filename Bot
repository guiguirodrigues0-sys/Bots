 /**
 * Calcula a exposição atual considerando posições OPEN e PENDING.
 * PENDING deve ser contado pois representa compras já enviadas à Deriv
 * que ainda não tiveram confirmação final de liquidação.
 */
 private currentExposurePct(): number {
 if (!this.balance || this.balance <= 0) {
 return 0;
 }
 // OPEN e PENDING contam para exposição - ambos representam capital comprometido
 const active = this.openTrades.filter((t) => t.status === "OPEN" || t.status === "PENDING");
 const totalStake = active.reduce(
 (a, t) => a + (t.buyPrice ?? t.stake),
 0,
 );
 return (totalStake / this.balance) * 100;
 }
 /**
 * Conta posições ativas (OPEN + PENDING) para limites de risco.
 * PENDING deve ser contado pois representa compras já enviadas à Deriv
 * que ainda não tiveram confirmação final de liquidação.
 */
 private activePositionCount(): number {
 return this.openTrades.filter((t) => t.status === "OPEN" || t.status === "PENDING").length;
 }
 /**
 * Reserva atômica de slot para uma nova operação.
 * Retorna true se a reserva foi bem-sucedida, false se exceder limites.
 */
 private reserveSlot(contractId: string, stake: number, symbol: string): boolean {
 if (!this.balance || this.balance <= 0) {
 return false;
 }
 
 const activeCount = this.activePositionCount();
 const risk = this.getRiskConfig();
 
 // Verifica limite de posições simultâneas
 if (this.activePositionCount() >= risk.maxOpenTrades) {
 return false;
 }
 
 // Verifica exposição total
 const activeStake = this.openTrades
 .filter((t) => t.status === "OPEN" || t.status === "PENDING")
 .reduce((a, t) => a + (t.buyPrice ?? t.stake), 0);
 
 const newExposurePct = ((activeStake + stake) / this.balance!) * 100;
 if (newExposurePct >= this.getRiskConfig().maxExposurePct) {
 return false;
 }
 
 // Reserva o slot
 this.pendingReservations.set(contractId, {
 contractId: contractId,
 reservedAt: Date.now(),
 stake: stake,
 symbol: symbol,
 });
 
 return true;
 }
 /**
