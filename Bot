}
function emit(level: Level, message: string, meta?: unknown): void {
 if (!shouldLog(level)) return;
 const entry = {
 ts: new Date().toISOString(),
 level,
 message,
 ...(meta !== undefined ? { meta } : {}),
 };
 const line = maskSecrets(JSON.stringify(entry));
 if (level === "error") {
 console.error(line);
 } else {
 console.log(line);
 }
}
