import type { Candle } from "../types.js";
import type { StrategyConfig, StrategyId } from "./types.js";
import { STRATEGY_IDS, STRATEGY_METADATA, defaultConfig } from "./definitions.js";
import { createStrategy } from "./registry.js";
export type StrategyDiagnosticStatus =
 | "OK"
 | "SEM_SINAL"
 | "DADOS_INSUFICIENTES"
 | "ERRO";
export interface StrategyDiagnosticEntry {
 strategyId: StrategyId;
 name: string;
 evaluations: number;
 buy: number;
 sell: number;
 wait: number;
 /** Avaliações bloqueadas por falta de dados/indicador inválido. */
 insufficient: number;
 /** Avaliações normais sem sinal (critérios não atendidos). */
 noSignal: number;
 /** Exceções lançadas durante a avaliação (falha técnica). */
 errors: number;
