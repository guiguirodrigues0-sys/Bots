function uptrend(n: number): number[] {
 const out: number[] = [];
 let v = 100;
 for (let i = 0; i < n; i++) {
 v += 0.05 + (i % 3) * 0.005;
 out.push(v);
 }
 return out;
}
function downtrend(n: number): number[] {
 const out: number[] = [];
 let v = 100;
 for (let i = 0; i < n; i++) {
 v -= 0.05 + (i % 3) * 0.005;
 out.push(v);
 }
 return out;
}
