 const atrPeriod = num(config.params, "atrPeriod", 14);
 const atrMinMult = num(config.params, "atrMinMult", 1.0);
 const atrMaxMult = num(config.params, "atrMaxMult", 3.0);
 const atr = last(atrSeries(candles, atrPeriod));
 if (atr === null || atr <= 0) {
 return insufficientSignal(this.id, price);
 }
 const i = candles.length - 1;
 const candle = candles[i];
 if (!candle) {
 return insufficientSignal(this.id, price);
 }
 const prevHigh = highestHigh(candles, lookback, i);
 const prevLow = lowestLow(candles, lookback, i);
 if (prevHigh === null || prevLow === null) {
