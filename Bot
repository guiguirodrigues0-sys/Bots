 ];
 const sellConditions: StrategyCondition[] = [
 { label: "Fechamento abaixo da mínima dos 20 candles", passed: breakoutDown },
 { label: `Amplitude >= ${atrMinMult}x ATR`, passed: rangeOk },
 { label: "Sem retorno imediato para a faixa", passed: notExtendedDown },
 ];
 const indicators = { atr, prevHigh, prevLow, range };
 if (buyConditions.every((c) => c.passed)) {
 return makeSignal(
 this.id,
 "BUY",
 price,
 buyConditions,
 indicators,
 `SINAL BUY — rompimento de resistência (${candle.close.toFixed(5)} > ${prevHigh.toFixed(5)}, ATR
${atr.toFixed(5)}).`,
 );
 }
 if (sellConditions.every((c) => c.passed)) {
 return makeSignal(
 this.id,
 "SELL",
 price,
 sellConditions,
 indicators,
 `SINAL SELL — rompimento de suporte (${candle.close.toFixed(5)} < ${prevLow.toFixed(5)}, ATR ${atr.toFixed(5)}).`,
 );
