import { test } from "node:test";
import assert from "node:assert/strict";
import type { Candle } from "../src/types.js";
import { createStrategy } from "../src/strategies/registry.js";
import { defaultConfig, STRATEGY_IDS } from "../src/strategies/definitions.js";
import { diagnoseStrategiesOnCandles } from "../src/strategies/diagnostics.js";
import type { StrategySignal } from "../src/strategies/types.js";
process.env.LOG_LEVEL = "error";
function mk(closes: number[]): Candle[] {
 const out: Candle[] = [];
 for (let i = 0; i < closes.length; i++) {
 const close = closes[i]!;
 const open = i === 0 ? close : closes[i - 1]!;
 out.push({
 time: i * 60,
 open,
 high: Math.max(open, close) + 0.02,
 low: Math.min(open, close) - 0.02,
 close,
 });
 }
 return out;
}
function uptrend(n: number, step = 0.02): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < n; i++) {
 closes.push(c);
 c += step + (i % 4) * 0.005;
 }
 return mk(closes);
}
function downtrend(n: number, step = 0.02): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < n; i++) {
 closes.push(c);
 c -= step + (i % 4) * 0.005;
 }
 return mk(closes);
}
/** Oscilação lateral (baixa tendência): indicadores válidos, sem sinal claro. */
function sideways(n: number): Candle[] {
 const closes: number[] = [];
 for (let i = 0; i < n; i++) {
 closes.push(100 + Math.sin(i / 5) * 0.5);
 }
 return mk(closes);
}
/** Queda seguida de alta: gera cruzamento de EMAs/MACD para cima. */
function downThenUp(downN: number, downStep: number, upN: number, upStep: number): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < downN; i++) {
 closes.push(c);
 c -= downStep;
 }
 for (let i = 0; i < upN; i++) {
 closes.push(c);
 c += upStep;
 }
 return mk(closes);
}
/** Alta seguida de queda: gera cruzamento para baixo. */
function upThenDown(upN: number, upStep: number, downN: number, downStep: number): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < upN; i++) {
 closes.push(c);
 c += upStep;
 }
 for (let i = 0; i < downN; i++) {
 closes.push(c);
 c -= downStep;
 }
 return mk(closes);
}
/** Tendência com ruído (para MACD_ADX). */
function trend(n: number, step: number, noise: number, down = false): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < n; i++) {
 closes.push(c);
 const s = (down ? -step : step) + (i % 5) * noise * (i % 2 === 0 ? 1 : -1);
 c += s;
 }
 return mk(closes);
}
/** Rally forte, recuo até a EMA50 e retomada (para TENDENCIA). */
function rallyPullback(): Candle[] {
 const closes: number[] = [];
 let c = 100;
 for (let i = 0; i < 200; i++) {
 closes.push(c);
 c += 0.1;
 }
 for (let i = 0; i < 10; i++) {
 closes.push(c);
 c -= 0.2;
 }
 for (let i = 0; i < 20; i++) {
 closes.push(c);
 c += 0.01;
 }
 return mk(closes);
}
function scan(id: Parameters<typeof createStrategy>[0], candles: Candle[]): StrategySignal[] {
 const strategy = createStrategy(id);
 const config = defaultConfig(id);
 const signals: StrategySignal[] = [];
 for (let i = 0; i < candles.length; i++) {
 strategy.onCandle(candles[i]!);
 signals.push(strategy.evaluateSignal(candles.slice(0, i + 1), config));
 }
 strategy.dispose();
 return signals;
}
