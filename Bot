const path = require("node:path");
const http = require("node:http");
const net = require("node:net");
const PORT_START = 47821;
const HEALTH_TIMEOUT_MS = 20000;
let backend = null;
let mainWindow = null;
let backendPort = null;
function findFreePort(start) {
 return new Promise((resolve) => {
 const attempt = (port) => {
 const server = net.createServer();
 server.once("error", () => attempt(port + 1));
 server.once("listening", () => {
 server.close(() => resolve(port));
 });
 server.listen(port, "127.0.0.1");
 };
 attempt(start);
 });
}
function waitForHealth(port) {
 return new Promise((resolve, reject) => {
 const deadline = Date.now() + HEALTH_TIMEOUT_MS;
 const attempt = () => {
 const req = http.get(
 { host: "127.0.0.1", port, path: "/api/health", timeout: 1500 },
 (res) => {
 if (res.statusCode === 200) {
 res.resume();
 resolve();
 } else {
 res.resume();
 retry();
 }
 },
 );
 req.on("error", retry);
 req.on("timeout", () => {
 req.destroy();
 retry();
 });
 };
 const retry = () => {
 if (Date.now() > deadline) {
 reject(new Error("Backend não respondeu em tempo hábil."));
 return;
 }
 setTimeout(attempt, 250);
 };
 attempt();
 });
}
async function startBackend() {
 backendPort = await findFreePort(PORT_START);
 const backendEntry = path.join(__dirname, "backend.cjs");
 const frontendDist = path.join(__dirname, "..", "frontend", "dist");
 process.env.DERIV_ENVIRONMENT = "demo";
 process.env.ALLOW_REAL_ACCOUNT = "false";
 process.env.HOST = "127.0.0.1";
 process.env.PORT = String(backendPort);
 process.env.DB_PATH = path.join(app.getPath("userData"), "deriv-demo-bot.db");
 process.env.FRONTEND_DIST = frontendDist;
 process.env.LOG_LEVEL = "info";
 backend = utilityProcess.fork(backendEntry, [], { stdio: "ignore" });
 backend.on("exit", () => {
 backend = null;
 });
 await waitForHealth(backendPort);
}
