 }
 const url = await this.api.getDemoWebSocketUrl();
 const ws = new WebSocketManager();
 this.ws = ws;
 ws.onMessage((msg) => this.handleMessage(msg));
 ws.onClose(() => this.handleDisconnect());
 await ws.connect(url);
 this.connectionState = "CONNECTED";
 this.setEvent("WEBSOCKET CONECTADO");
 await this.loadMarket(config.symbol, config.granularity);
 this.restorePendingTrades();
 await this.resubscribePending(ws);
 const balanceMsg = await ws.request({ balance: 1 });
 const b = balanceMsg.balance as { balance: number; currency: string } | undefined;
 if (b) {
 this.updateBalance(b.balance, b.currency);
 }
 }
 /**
 * Re-assina contratos pendentes persistidos (após reinício) para que a
 * liquidação seja recebida e reconciliada.
 * TODOS os símbolos são re-assinados para garantir reconciliação completa.
 */
 private async resubscribePending(ws: WebSocketManager): Promise<void> {
 for (const pending of tradeHistoryStore.listPending()) {
 try {
 await ws.request({
 proposal_open_contract: 1,
 contract_id: contractIdParam(pending.id),
 subscribe: 1,
 });
 logger.info("Re-assinando contrato pendente", { contractId: pending.id, symbol: pending.symbol });
 } catch (err) {
 logger.warn("Falha ao re-assinar contrato pendente", {
 contractId: pending.id,
 message: err instanceof Error ? err.message : String(err),
 });
 }
 }
 }
 /**
 * Restaura TODOS os contratos PENDING persistidos (de sessões/reinícios anteriores)
 * para a memória, de modo que:
 * - o painel mostre a posição em andamento;
 * - o gerenciamento de risco conte a exposição/bloqueio corretamente;
 * - novas compras sejam bloqueadas enquanto o estado for desconhecido.
 *
 * TODOS os símbolos são restaurados para garantir reconciliação completa.
 * O estado de reconciliação é rastreado separadamente.
 */
 private restorePendingTrades(): void {
 const pending = tradeHistoryStore.listPending();
 for (const p of pending) {
 if (this.openTrades.some((t) => t.contractId === p.id)) {
 continue;
 }
 const strategyId = (STRATEGY_IDS as string[]).includes(p.strategy)
 ? (p.strategy as StrategyId)
 : (this.manager.getActiveId() ?? "CONFLUENCIA");
 this.openTrades.push({
 contractId: p.id,
 proposalId: "",
 symbol: p.symbol,
 strategyId,
 direction: p.direction,
 stake: p.stake,
 entryTime: p.timestamp,
 duration: p.duration,
 durationSeconds: durationInSeconds(p.duration, p.durationUnit),
 durationUnit: p.durationUnit,
 granularity: p.granularity ?? 0,
 askPrice: p.entryPrice,
 buyPrice: p.buyPrice,
 payout: p.payout,
 status: "PENDING", // Estado PENDING até reconciliação
 profit: null,
 reconciliationState: "PENDING_RECONCILIATION",
 lastReconciliationAt: null,
 lastTickAt: null,
 });
 }
 if (pending.length > 0) {
 logger.info("Contratos pendentes restaurados para reconciliação", {
 count: pending.length,
 });
