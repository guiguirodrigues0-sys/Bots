* Detecta rompimentos de suporte/resistência (máx/mín 20 candles, ATR 14).
* Volume só seria usado se estivesse disponível e confiável (não fornecido
* pela Deriv para estes subjacentes).
*/
export class RompimentoStrategy extends BaseStrategy {
 readonly id: StrategyId = "ROMPIMENTO";
 evaluateSignal(candles: Candle[], config: StrategyConfig): StrategySignal {
